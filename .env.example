# The deterministic adapter keeps ordinary local tests and manual smoke checks network-free.
LLM_PROVIDER=scripted
LLM_MODEL=scripted-v1

# Local service identity: python scripts/init_local_identity.py
# Generated value stays in ignored work/local-identity.json, never browser bundles.
# For deployment inject COPILOT_SERVICE_SECRET through the server environment.
# COPILOT_PANEL_ORIGIN=https://<panel-host>
# COPILOT_STORE_ORIGIN=https://<store-host>
# COPILOT_STORE_PRIVATE_URL=http://127.0.0.1:4000
# COPILOT_ENV=production
# Public origins above configure server validation only; cloud browser/proxy wiring
# is a separate deployment step. Never enable COPILOT_EVALUATION in public hosting.

# Pinned local MVP baseline. Keep the real key only in `.env`.
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=<local-secret>
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# LLM_TIMEOUT_SECONDS=20
# LLM_REASONING_EFFORT=low

# Enable these NVIDIA settings only for an explicit local evaluation or smoke test.
# Keep the real key only in `.env`.
# LLM_PROVIDER=nvidia
# LLM_MODEL=<evaluated-model-id>
# NVIDIA_API_KEY=<local-secret>
# LLM_TIMEOUT_SECONDS=20
# NVIDIA_STREAM=false

# The later AWS milestone will use the standard AWS credential chain.
# AWS_REGION=eu-central-1
# Optional Gemini evaluation (keep the real key in ignored .env only).
# GEMINI_API_KEY=
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# OpenRouter paid evaluation requires a non-resetting API key limit.
# Default local maximum is $0.25. Owner-authorized voice testing permits up to $0.75 total.
# The actual key limit and this local limit must agree; never enable auto top-up.
# OPENROUTER_API_KEY=
# OPENROUTER_TOTAL_CAP_DOLLARS=0.75
# LLM_PROVIDER=openrouter
# LLM_MODEL=google/gemini-2.5-flash
